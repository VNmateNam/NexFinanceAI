PORT=4000
NODE_ENV=development

# ── Supabase (FREE) ──────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Market Data APIs (ALL FREE) ───────────────────────────────
# Alpha Vantage: https://www.alphavantage.co/support/#api-key (FREE: 25 req/day)
ALPHA_VANTAGE_KEY=YOUR_ALPHA_VANTAGE_KEY

# NewsAPI: https://newsapi.org/register (FREE: 100 req/day)
NEWSAPI_KEY=YOUR_NEWS_API_KEY

# GNews: https://gnews.io (FREE: 100 req/day)
GNEWS_KEY=YOUR_GNEWS_KEY

# Metals.live: No key needed — gold/silver spot prices, unlimited FREE
# Frankfurter: No key needed — exchange rates, unlimited FREE

# ── AI ────────────────────────────────────────────────────────
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Notifications ─────────────────────────────────────────────
# Resend: https://resend.com (FREE: 3000 emails/month)
RESEND_API_KEY=re_...

# Twilio: https://twilio.com (trial credit included)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE=+1234567890

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_string_of_at_least_32_characters
FRONTEND_URL=http://localhost:5173
